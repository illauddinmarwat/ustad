# Used by Apache / LiteSpeed shared hosting (cPanel and similar). Other hosts ignore it.
# Show the site's own 404 page and never list folder contents.
ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html

# Send every visit to HTTPS. This needs a working SSL certificate on the domain; if the certificate
# ever lapses, comment these three lines out again or the site becomes unreachable.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
