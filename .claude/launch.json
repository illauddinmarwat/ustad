{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ustad-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web-admin"
      ],
      "port": 3000
    },
    {
      "name": "ustad-mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "--prefix",
        "mobile"
      ],
      "port": 8081
    },
    {
      "name": "ustad-mobile-fixture",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set EXPO_PUBLIC_USE_FIXTURES=1&& npm run web --prefix mobile -- --port 8082"
      ],
      "port": 8082
    }
  ]
}
